---
import { type Row } from "../utils";

interface Props {
  people: Row[];
  showNames?: boolean;
}

const { people, showNames } = Astro.props;
const { accommodation } = people.find((p) => !!p.accommodation) || {};
const seeAll = people.find((p) => !!p.seeAll)?.seeAll == "yes";
---

{
  people.length && people.every((p) => p.attending == "no") ? (
    <div class="p-24">
      Sad to miss you! Lots of love and hope to see you soon!
    </div>
  ) : (
    <>
      <hr class="m-2" />

      {showNames && (
        <>
          <div class="ml-12">
            {people.map((p) => (
              <p>
                {p.attending === "yes" ? "✅ " : "❌ "} {p.name}
              </p>
            ))}
          </div>
          <hr class="m-2" />
        </>
      )}

      {/* <!-- ACCOMMODATION INFO  --> */}
      {!!accommodation && (
        <section class="m-2 rounded p-2">
          <h2 class="text-lg font-bold">Accommodation</h2>
          You're down to stay in: {accommodation}
          <hr class="m-2" />
        </section>
      )}

      {/* <!-- LOCATION INFO  --> */}

      <section class="m-2 rounded p-2">
        <h2 class="text-lg font-bold">Location</h2>
        <div class="grid grid-cols-2">
          <div class="flex flex-col justify-center">
            <p>
              <a
                href="https://maps.app.goo.gl/Uac833vJFLPrjVB67"
                target="_blank"
                class="font-bold underline"
              >
                OA Surf Club,
              </a>
              <br /> Atlantic Court, Widemouth Bay, Cornwall, EX23 0DF
            </p>
          </div>
          <div class="">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d10089.620279026898!2d-4.569662926881236!3d50.786601196530285!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x486c77bce0d2d9ff%3A0x24f9b527d994a22f!2sOA%20Surf%20Club%20-%20Accommodation%2C%20Widemouth%20Bay%2C%20Bude%2C%20Cornwall!5e0!3m2!1sen!2suk!4v1726951071494!5m2!1sen!2suk"
              class="h-[200%] w-[200%] origin-top-left scale-50 rounded-lg"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        </div>
      </section>

      <hr class="m-2" />

      {/* <!-- TIMING INFO  --> */}

      <section class="m-2 rounded p-2">
        <h2 class="text-lg font-bold">Timetable</h2>
        {seeAll ? (
          <p>Festivities will be occurring throughout the weekend</p>
        ) : (
          <> </>
        )}

        <table class="my-2 w-full table-auto">
          <tbody class="divide-y divide-gray-200">
            {seeAll && (
              <>
                <tr>
                  <td class="font-bold">Friday 13th June</td>
                </tr>
                <tr>
                  <td>3pm</td>
                  <td>Check in</td>
                </tr>
                <tr>
                  <td>Evening</td>
                  <td>Takeout and beers on the beach</td>
                </tr>
              </>
            )}

            <tr>
              <td class="pt-4 font-bold">Saturday 14th June</td>
            </tr>

            {seeAll && (
              <>
                <tr>
                  <td>8:30-9:30</td>
                  <td>Breakfast (included in accommodation)</td>
                </tr>
                <tr>
                  <td>Morning</td> <td>Hike/surf/hangout</td>
                </tr>
                <tr>
                  <td>Lunch</td> <td>Mega pasty order</td>
                </tr>
              </>
            )}

            <tr>
              <td>from 2pm</td> <td>Welcome drinks</td>
            </tr>
            <tr>
              <td>3pm</td> <td>Ceremony</td>
            </tr>
            <tr>
              <td>5pm</td> <td>Dinner</td>
            </tr>
            <tr>
              <td>7:30pm</td> <td>Ceileidh</td>
            </tr>
            <tr>
              <td>10pm-late</td> <td>Disco</td>
            </tr>
            {seeAll && (
              <>
                <tr>
                  <td class="pt-4 font-bold">Sunday 15th June</td>
                </tr>
                <tr>
                  <td>8:30-9:30</td>
                  <td>Breakfast (included in accommodation)</td>
                </tr>
                <tr>
                  <td>11am</td>
                  <td>Checkout</td>
                </tr>
              </>
            )}
          </tbody>
        </table>
      </section>
    </>
  )
}
