---
import Layout from "../layouts/Layout.astro";
import { getFoodOrders } from "../utils";
import _ from "lodash";
const orders = (await getFoodOrders())
  .filter((o) => o.foodOrder.length > 0)
  .toSorted((a, b) => a.code.localeCompare(b.code));

const showPrices = Astro.url.searchParams.get("prices");
---

<Layout title="All Food Orders">
  <div class="flex h-full flex-col justify-around overflow-scroll">
    <h1 class="pr-2 text-center text-2xl font-bold">All Food Orders</h1>
    <div class="flex flex-col gap-4">
      {
        orders.map((order) => (
          <div>
            <p class="font-bold">
              {order.name}
              {showPrices &&
                ` - £${_.sumBy(order.foodOrder, (item) => item.price).toFixed(2)}`}
            </p>
            {order.foodOrder
              .toSorted((a) => (a.item.includes("Pasty") ? -1 : 1))
              .map((item) => (
                <p class="pl-4 text-sm">{item.item}</p>
              ))}
          </div>
        ))
      }
    </div>
  </div>
</Layout>
