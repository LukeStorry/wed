---
import Layout from "../layouts/Layout.astro";
import FoodOrderForm from "../components/FoodOrderForm";
import { getFoodOrders, getRowsFromCode, handleUpdateForm } from "../utils";
import { menu } from "../menu";

const codeFromCookies = Astro.cookies.get("rsvp-code")?.value;

let initialName = undefined;
let result = null;

if (codeFromCookies) {
  const people = await getRowsFromCode(codeFromCookies);
  initialName = people.length === 1 ? people[0]?.name : undefined;
}

if (Astro.request.method === "POST") {
  console.log("Food POST Received");
  const rawFormData = await Astro.request.formData();
  result = await handleUpdateForm(rawFormData);
  Astro.cookies.set("rsvp-code", result.code);
  if (result.name) initialName = result.name;
}

const orders = await getFoodOrders();
---

<Layout title="Food Order">
  <div class="flex h-full flex-col justify-around overflow-scroll">
    <h1 class="pr-2 text-center text-2xl font-bold">Food Order</h1>

    <FoodOrderForm
      client:load
      orders={orders}
      menu={menu}
      initialName={initialName}
    />
  </div>
</Layout>

<script define:vars={{ result }}>
  if (result) {
    alert(`Saved! ${result.foodOrder.map((item) => item.item).join(", ")}`);
  }
</script>
