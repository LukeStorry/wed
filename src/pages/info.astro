---
import RsvpInfo from "../components/RsvpInfo.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import saveTheDate from "../images/save_the_date.png";
import { getRowsFromCode } from "../utils";

const codeFromUrl = Astro.url.searchParams.get("code");

if (codeFromUrl == "clear" || Astro.url.searchParams.get("clear"))
  Astro.cookies.delete("rsvp-code");

const codeFromCookies = Astro.cookies.get("rsvp-code")?.value;

if (codeFromUrl && codeFromUrl != "clear" && !codeFromCookies)
  Astro.cookies.set("rsvp-code", codeFromUrl);

if (codeFromCookies && !codeFromUrl)
  return Astro.redirect("/info?code=" + codeFromCookies);

const code = codeFromUrl;
const people = code ? await getRowsFromCode(code) : [];
---

<script define:vars={{ people, code }} is:inline>
  console.log(code, JSON.stringify(people, null, 2));
</script>

{
  people.length ? (
    <Layout title="WeddingInfo">
      <div class="flex h-full flex-col justify-around overflow-scroll">
        <h1 class="pr-2 text-center text-2xl font-bold">Info</h1>
        <RsvpInfo people={people} />
      </div>
    </Layout>
  ) : (
    <Layout title="Save The Date" onCardClick="/" blackBackground>
      <Image
        src={saveTheDate}
        class="h-full w-full rounded-xl object-contain"
        alt="Luke and Marnie are getting Married. Save the Date: 14th June 2025. Widemouth Bay, Cornwall. More info to come."
        loading="eager"
      />
    </Layout>
  )
}
